# Used by infra/docker-compose.yml. Never commit the real .env.
SQL_SA_PASSWORD=

# Optional. Without it the app uses the labelled rule-based interviewer and scorer.
ANTHROPIC_API_KEY=

# Optional. Without it only email sign-in is offered.
GOOGLE_CLIENT_ID=

# Optional. Without them upgrades are hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Signing up with this email grants admin: /api/admin/metrics and the /ops/jobs dashboard.
ADMIN_EMAIL=
